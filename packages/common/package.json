        "json5": "^2.2.3",
        "typed-event-target": "^4.3.3"
    },
    "devDependencies": {
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-playwright": "^1.0.0",
        "execute-in-browser": "^1.0.10",
        "istanbul-smart-text-reporter": "^1.1.5",
        "runstorm": "^1.0.6",
        "typescript": "^6.0.3"
