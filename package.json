{
    "name": "@augment-vir/mono-repo-root",
    "version": "31.51.1",
    "private": true,
    "homepage": "https://github.com/electrovir/augment-vir",
    "bugs": {
        "url": "https://github.com/electrovir/augment-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/augment-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "compile": "npm run init && bash compile.sh",
        "docs": "npm run exec --workspace @augment-vir/scripts src/scripts/run-typedoc.script.ts",
        "format": "virmator format",
        "init": "patch-package && cd packages/common && tsc -b -f --pretty && cd ../.. && tsx packages/node/src/scripts/fix-ts-bin.script.ts",
        "lint": "virmator lint fix",
        "publish": "virmator publish \"npm run test:all\"",
        "test": "mono-vir for-each npm run test",
        "test:all": "npm run compile && runstorm --names spelling,format,deps,lint,exports,docs \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\" \"npm run test:exports\" \"npm run test:docs\" && npm run test:coverage",
        "test:coverage": "mono-vir for-each npm run test:coverage",
        "test:deps": "virmator deps check",
        "test:docs": "npm run docs",
        "test:exports": "npm run exec --workspace @augment-vir/scripts src/scripts/verify-exports.script.ts",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each-async npm run test:update"
    },
    "overrides": {
        "is-generator-function": "1.1.0",
        "playwright": "^1.56.1",
        "type-fest": "^5.2.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "9.39.1",
        "@stylistic/eslint-plugin": "^5.5.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "cspell": "^9.3.0",
        "dependency-cruiser": "^17.2.0",
        "esbuild": "^0.25.12",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^61.1.12",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.3.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "~62.0.0",
        "mono-vir": "^2.4.1",
        "npm-check-updates": "^19.1.2",
        "patch-package": "^8.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.5.0",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^0.6.2",
        "typescript-eslint": "^8.46.3",
        "virmator": "^14.2.2"
    },
    "engines": {
        "node": ">=22"
    }
}
